# ──────────────────────────────────────────────────────────────
# Ignis Edge — Frontend (Vite) environment variables
# Copia este archivo a `.env` y rellena los valores reales.
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# Backend FastAPI (HTTP REST)
# Ej: http://localhost:8000  ·  https://api.ignis.tu-dominio.com
VITE_API_BASE_URL=http://localhost:8000

# Backend WebSocket (sim ticks + telemetría LoRa)
# Ej: ws://localhost:8000  ·  wss://api.ignis.tu-dominio.com
VITE_WS_BASE_URL=ws://localhost:8000

# Mapbox public token (pk.*) — actualmente está hardcoded en MapContainer.tsx,
# pero puedes externalizarlo aquí si lo prefieres.
# VITE_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxx
